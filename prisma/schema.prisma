generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RunStatus {
  UPLOADED
  PROCESSING
  COMPLETED
  COMPLETED_WITH_ERRORS
  CANCELLED
}

enum RowStatus {
  PENDING
  PROCESSING
  COMPLETED
  ERROR_RETRY
  FAILED
}

enum AttemptOutcome {
  SUCCESS
  API_ERROR
  MAPPING_ERROR
}

// Reporting-layer state machine only -- completely separate from
// RunStatus/RowStatus. Nothing here can transition a ranking_run/ranking_row,
// and nothing in backend/statemachine or backend/worker references it.
enum ReportStatus {
  PENDING_ANALYSIS
  ANALYSIS_FAILED
  ANALYSIS_READY
  REPORT_READY
  EMAIL_DRAFT_FAILED
  EMAIL_DRAFTED
  PENDING_APPROVAL
  APPROVED
  // Atomically claimed from APPROVED right before the real ClickUp send
  // automation runs -- see reportTransitions.ts's markSending/markSendFailed.
  // Exists solely so two concurrent approve-and-send calls can never both
  // execute sendEmail() for the same report: only one can win the
  // APPROVED -> SENDING transition, the loser is rejected before ever
  // touching ClickUp. On failure this reverts to APPROVED (so a legitimate
  // retry stays possible); on success it becomes SENT.
  SENDING
  REJECTED
  SENT
}

// Access/workspace layer -- additive on top of the existing ranking/
// reporting pipeline, which keys off Client.id only and is otherwise
// unaffected. A Workspace is a data row (not an enum) deliberately, matching
// this schema's existing convention (see reportTone/reportingFrequency/
// templateId below) of free-text values over enums for anything that might
// grow, since "SEO" / "Advanced SEO" today is exactly the kind of set that
// gains a third member later.
model Workspace {
  id        String   @id @default(uuid())
  slug      String   @unique // "seo" | "advanced-seo" -- stable, URL/code-safe key
  name      String   // display label, e.g. "SEO", "Advanced SEO"
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  clients     Client[]
  memberships WorkspaceMembership[]

  @@map("workspaces")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String?
  role         String   @default("member") @map("role") // free text: "member" | "admin" -- orthogonal to workspace visibility, see WorkspaceMembership
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  memberships WorkspaceMembership[]
  sessions    Session[]

  @@map("users")
}

// Server-side session storage -- the opaque id is what's sent to the
// browser as an httpOnly cookie; nothing about the user/role/workspace is
// ever encoded client-side. Chosen over JWT specifically so a session can
// be revoked instantly (delete the row) without needing a denylist.
model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("sessions")
}

// Which user can see which workspace(s) -- a visibility list, not a
// privilege-escalation mechanism. A single-workspace user gets exactly one
// row here; an admin who legitimately oversees both workspaces gets two.
// This is what lets the clients-list query treat "sees one" and "sees both"
// as the same shape, with no admin-specific branch anywhere.
model WorkspaceMembership {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id])
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([userId, workspaceId])
  @@map("workspace_memberships")
}

model Client {
  id          String     @id @default(uuid())
  name        String
  // Nullable deliberately, not backfilled to a default workspace: an
  // existing real client silently mis-assigned to the wrong workspace at
  // migration time would be worse than it being invisible (in neither
  // workspace's dropdown) until a human explicitly triages it.
  workspaceId String?    @map("workspace_id")
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])
  // True for rows created by test suites / manual spike testing (the
  // existing "API Test ...", "Reports API Test ..." naming convention),
  // backfilled once at migration time. Kept as an explicit flag rather than
  // inferred from workspaceId being null, since null alone is ambiguous
  // between "test data" and "real client not yet triaged into a workspace."
  isTestData Boolean  @default(false) @map("is_test_data")
  isActive   Boolean  @default(true) @map("is_active")
  // Free-text internal notes, set/edited only from Client Management -- never
  // surfaced to the client, never read by the ranking/reporting pipeline.
  notes      String?  @map("notes")
  // Soft-delete marker for "Delete client" in Client Management. Distinct
  // from isActive: archiving always also sets isActive false (enforced in
  // the archive endpoint), but restoring leaves isActive false so a
  // restored client doesn't silently reappear in run/client dropdowns --
  // re-activating is a separate, deliberate action. A real hard delete
  // isn't generally possible anyway: Client -> RankingRun/ClientReportConfig/
  // RankingReport are all ON DELETE RESTRICT in the DB.
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  runs          RankingRun[]
  reportConfigs ClientReportConfig[]
  reports       RankingReport[]

  @@index([workspaceId, isActive])
  @@map("clients")
}

// Reporting-layer config only -- deliberately isolated from the ranking
// pipeline. No RankingRun/RankingRow/RankingRowAttempt model references or
// is referenced by this model, and nothing in backend/statemachine or
// backend/worker reads from this table.
model ClientReportConfig {
  id       String @id @default(uuid())
  clientId String @map("client_id")
  client   Client @relation(fields: [clientId], references: [id])

  reportTone         String  @map("report_tone") // e.g. "professional" | "casual" | "technical" -- free text, not an enum, so new tones don't need a migration
  sectionsEnabled    Json    @map("sections_enabled") // e.g. ["summary","wins","losses","recommendations","full_table"]
  metricsEnabled     Json    @map("metrics_enabled") // e.g. ["averageRank","top3","top10","notIn100"]
  customInstructions String? @map("custom_instructions")
  recipients         Json // email addresses -- resolved by the backend only, never AI-decided
  cc                 Json?   @map("cc") // optional CC email addresses -- same resolution rule as recipients
  clickupTaskId      String? @map("clickup_task_id") // primary: bare ClickUp task id (e.g. "86d45e14k") -- resolved into a full URL as https://app.clickup.com/t/{id} when set
  clickupTaskUrl     String? @map("clickup_task_url") // fallback: the ClickUp task whose Email composer delivers this client's reports, used verbatim when clickupTaskId is unset -- resolved by the backend only, same as recipients
  reportingFrequency String  @map("reporting_frequency") // "weekly" | "biweekly" | "monthly" | "manual"
  templateId         String  @map("template_id") // selects a deterministic report renderer, not a Claude choice

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([clientId, isActive])
  @@map("client_report_configs")
}

model RankingRun {
  id             String    @id @default(uuid())
  clientId       String    @map("client_id")
  client         Client    @relation(fields: [clientId], references: [id])
  sourceFilename String    @map("source_filename")
  sourceFilePath String    @map("source_file_path")
  resultFilePath String?   @map("result_file_path")
  status         RunStatus @default(UPLOADED)
  totalRows      Int       @map("total_rows")
  createdBy      String?   @map("created_by")
  startedAt      DateTime? @map("started_at")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  rows RankingRow[]

  // Reverse sides of RankingReport's two FKs into ranking_runs, required by
  // Prisma's relation validation. Purely a schema-level back-reference --
  // no new column on ranking_runs, no behavioral change to the ranking
  // pipeline, and RankingRun never reads/writes RankingReport itself.
  reportsAsCurrentRun  RankingReport[] @relation("ReportRun")
  reportsAsPreviousRun RankingReport[] @relation("ReportPreviousRun")

  @@map("ranking_runs")
}

model RankingRow {
  id               String    @id @default(uuid())
  runId            String    @map("run_id")
  run              RankingRun @relation(fields: [runId], references: [id])
  rowUid           String    @map("row_uid")
  sourceRowNumber  Int       @map("source_row_number")

  keyword       String
  fullUrl       String?  @map("full_url")
  targetUrl     String   @map("target_url")
  concatenate   String?
  locationName  String   @map("location_name")
  seDomain      String   @map("se_domain")
  languageName  String   @map("language_name")

  status          RowStatus @default(PENDING)
  rankValue       Int?      @map("rank_value")
  rankDisplay     String?   @map("rank_display")
  rankingUrl      String?   @map("ranking_url")

  retryCount       Int     @default(0) @map("retry_count")
  maxRetries       Int     @default(3) @map("max_retries")
  lastErrorMessage String? @map("last_error_message")

  lastAttemptId String?           @unique @map("last_attempt_id")
  lastAttempt   RankingRowAttempt? @relation("LastAttempt", fields: [lastAttemptId], references: [id])

  attempts RankingRowAttempt[] @relation("RowAttempts")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([runId, status])
  @@index([rowUid])
  @@map("ranking_rows")
}

model RankingRowAttempt {
  id            String  @id @default(uuid())
  rankingRowId  String  @map("ranking_row_id")
  rankingRow    RankingRow @relation("RowAttempts", fields: [rankingRowId], references: [id])
  attemptNumber Int     @map("attempt_number")

  requestPayload          Json    @map("request_payload")
  httpStatus              Int?    @map("http_status")
  dataforseoStatusCode    Int?    @map("dataforseo_status_code")
  dataforseoStatusMessage String? @map("dataforseo_status_message")
  rawResponse             Json?   @map("raw_response")

  mappedRankValue  Int?    @map("mapped_rank_value")
  mappedRankingUrl String? @map("mapped_ranking_url")

  outcome      AttemptOutcome
  errorMessage String?        @map("error_message")

  createdAt DateTime @default(now()) @map("created_at")

  lastAttemptOf RankingRow? @relation("LastAttempt")

  @@index([rankingRowId])
  @@map("ranking_row_attempts")
}

// Reporting-layer only -- isolated from the ranking worker/state machine.
// Reads a completed RankingRun's data via computeRunAnalytics (backend
// code), then Claude fills analysisJson/emailSubject/emailBody. Nothing
// here ever writes to ranking_runs/ranking_rows/ranking_row_attempts, and
// nothing in backend/statemachine or backend/worker reads this table.
model RankingReport {
  id             String       @id @default(uuid())
  runId          String       @map("run_id")
  run            RankingRun   @relation("ReportRun", fields: [runId], references: [id])
  previousRunId  String?      @map("previous_run_id")
  previousRun    RankingRun?  @relation("ReportPreviousRun", fields: [previousRunId], references: [id])
  clientId       String       @map("client_id")
  client         Client       @relation(fields: [clientId], references: [id])

  status ReportStatus @default(PENDING_ANALYSIS)

  analyticsJson      Json?   @map("analytics_json") // computeRunAnalytics output -- pure code, no Claude
  analysisJson       Json?   @map("analysis_json") // Claude Report Analyst's schema-validated output
  reportHtml         String? @map("report_html") // deterministic Report Generator output (legacy full-narrative report path)
  clientPdfPath      String? @map("client_pdf_path") // deterministic client-facing PDF (Summary + Keyword Table) written to disk by buildReport -- the SAME file streamed by GET /:id/pdf and attached to the email; generated once, never regenerated
  // Optional human override of the email attachment -- NEVER replaces or
  // deletes clientPdfPath, which stays the permanent generated-report
  // record regardless of which one gets sent. attachmentSource picks which
  // file approveAndSendReport actually attaches; customPdfPath/Filename are
  // only ever read when it's "custom". If "custom" is selected but the file
  // is missing on disk at send time, the send fails loudly rather than
  // silently falling back to the generated PDF (see approveAndSend.ts).
  attachmentSource   String  @default("generated") @map("attachment_source") // "generated" | "custom"
  customPdfPath      String? @map("custom_pdf_path")
  customPdfFilename  String? @map("custom_pdf_filename") // original uploaded filename -- used as the attachment's display name when sending, since customPdfPath itself is a generated on-disk name
  emailSubject       String? @map("email_subject") // Claude Email Draft Generator's output (subject)
  emailBody          String? @map("email_body") // Claude Email Draft Generator's output (bodyText)
  emailBodyHtml      String? @map("email_body_html") // Claude Email Draft Generator's output (bodyHtml)
  resolvedRecipients Json?   @map("resolved_recipients") // copied from ClientReportConfig.recipients, human-editable, never AI-decided
  resolvedCc         Json?   @map("resolved_cc") // copied from ClientReportConfig.cc, human-editable, same rule as resolvedRecipients
  resolvedClickupTaskUrl String? @map("resolved_clickup_task_url") // copied from ClientReportConfig.clickupTaskUrl, human-editable, never Claude-decided

  lastErrorMessage String? @map("last_error_message")

  approvedBy String?   @map("approved_by")
  approvedAt DateTime? @map("approved_at")
  sentAt     DateTime? @map("sent_at")
  // Set only when sentAt is set (SENDING -> SENT). Distinguishes "email
  // sent, audit trail also posted" (true) from "email genuinely sent, but
  // the follow-up ClickUp audit comment failed" (false) -- a failed audit
  // comment NEVER blocks or reverses the send itself (see approveAndSend.ts
  // / clickupEmailSender.ts's postAuditComment), it only means this stays
  // false so the gap is visible here instead of only in server logs. Null
  // for reports sent before this field existed, or by a sender that
  // doesn't model an audit-comment step at all (e.g. the mock).
  auditCommentPosted Boolean? @map("audit_comment_posted")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([clientId, status])
  @@index([runId])
  @@map("ranking_reports")
}
