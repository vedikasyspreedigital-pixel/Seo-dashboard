# Postgres connection string. Local dev commonly runs Postgres on a
# non-default port to avoid clashing with a system install -- adjust to match
# your own local database.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ranking"

# --- DataForSEO (real search-ranking data) ---------------------------------
# Basic Auth credentials from your DataForSEO dashboard.
DATAFORSEO_LOGIN=you@example.com
DATAFORSEO_PASSWORD=...
# Safety gate: MOCK data unless this is exactly "true". Never commit this as
# "true" -- set it per-environment (Render dashboard in production).
DATAFORSEO_LIVE=false

# --- ClickUp report delivery (Playwright automation) -----------------------
# Safety gate: MOCK (no real send) unless this is exactly "true". Flipping
# this to "true" also requires a Playwright session-state JSON file to exist
# at CLICKUP_SESSION_PATH -- produced by running `npm run setup-session` in
# spikes/clickup-feasibility (an interactive, human-login script; it cannot
# run headless/unattended) and placing the resulting file there.
CLICKUP_EMAIL_LIVE=false
# Where that session-state JSON lives. Defaults to a repo-relative path
# locally; in production this MUST point at a persistent disk/volume (see
# render.yaml), since a plain app-directory path won't survive a redeploy.
CLICKUP_SESSION_PATH=spikes/clickup-feasibility/session/clickup-storage-state.json

# --- Claude (report analysis + email draft) ---------------------------------
# Safety gate: MOCK (fixed placeholder text) unless this is exactly "true".
CLAUDE_LIVE=false
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5

# --- File storage ------------------------------------------------------------
# Uploaded keyword Excel files and generated client-facing PDFs. Both default
# to repo-relative folders locally; in production BOTH must point at a
# persistent disk/volume, or every file is lost on the next redeploy/restart.
UPLOADS_DIR=uploads
REPORTS_DIR=reports

# --- Server / CORS ------------------------------------------------------------
PORT=3001
# Set to exactly "production" in production -- this also controls whether
# session cookies are issued as secure/sameSite=none (required for the
# frontend and backend being on different domains).
NODE_ENV=development
# Comma-separated list of origins allowed to call this API cross-origin.
CORS_ORIGINS=http://localhost:5173

# --- Frontend (frontend/.env, not this file) --------------------------------
# VITE_API_BASE_URL=https://your-backend.onrender.com   # baked in at build time; leave unset locally (Vite proxies /api to the backend instead)
