# Copy to .env for local development. Placeholders only -- never commit real
# keys or passwords. In production (Railway) set these in the service's
# Variables tab instead.

# Postgres connection string. Local dev commonly runs Postgres on a
# non-default port to avoid clashing with a system install -- adjust to match
# your own local database.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ranking"

# --- DataForSEO (real search-ranking data) ---------------------------------
# Basic Auth credentials from your DataForSEO dashboard.
DATAFORSEO_LOGIN=you@example.com
DATAFORSEO_PASSWORD=...
# Safety gate: MOCK data unless this is exactly "true". Never commit this as
# "true" -- set it per-environment (Railway Variables in production).
DATAFORSEO_LIVE=false

# --- ClickUp report delivery (Playwright automation) -----------------------
# Safety gate: MOCK (no real send) unless this is exactly "true". Flipping
# this to "true" also requires a Playwright session-state JSON file to exist
# at CLICKUP_SESSION_PATH -- produced by running `npm run setup-session` in
# spikes/clickup-feasibility (an interactive, human-login script; it cannot
# run headless/unattended) and placing the resulting file there.
CLICKUP_EMAIL_LIVE=false
# Where that session-state JSON lives. Defaults to a repo-relative path
# locally; in production this MUST point at the persistent volume (e.g.
# /var/data/uploads/clickup-storage-state.json), or it is lost on redeploy.
CLICKUP_SESSION_PATH=spikes/clickup-feasibility/session/clickup-storage-state.json
# The Advanced SEO workspace's own ClickUp login (`npm run setup-session:advanced-seo`).
# CLICKUP_SESSION_PATH_ADVANCED_SEO=/var/data/uploads/clickup-storage-state-advanced-seo.json
# Debugging only: save a page snapshot before every ClickUp send (large files -- leave off).
# CLICKUP_DEBUG_SNAPSHOTS=false

# --- Domain Intelligence ------------------------------------------------------
# Posting reports as ClickUp COMMENTS on each client's domain-report task.
# MOCK unless exactly "true" (uses the same ClickUp session as above).
CLICKUP_COMMENTS_LIVE=false
# How tool exports are fetched:
#   mock       (default) nothing is contacted -- made-up data for local work
#   agent      the office Chrome extension (extension/) does the work in a
#              signed-in Chrome; needs DOMAIN_INTEL_AGENT_TOKEN below
#   playwright this server drives a browser with a saved Flikover login (Ahrefs only)
DOMAIN_INTEL_FETCH_MODE=mock
# Shared secret between this server and the Chrome extension (Settings -> Agent token).
# Any long random string; the extension can't connect without it.
DOMAIN_INTEL_AGENT_TOKEN=
# Keep Ahrefs on the server's Playwright robot even in agent mode ("playwright"); default: the agent.
# DOMAIN_INTEL_AHREFS_VIA=
# Playwright mode only: the saved Flikover login, and a folder for failure screenshots.
# FLIKOVER_SESSION_PATH=spikes/domain-intel-fetch/session/flikover-storage-state.json
# DOMAIN_INTEL_DEBUG_DIR=
# Mock mode only: a real Ahrefs export to return instead of the made-up one.
# DOMAIN_INTEL_MOCK_AHREFS_FILE=
# Legacy switch, same as DOMAIN_INTEL_FETCH_MODE=playwright.
# DOMAIN_INTEL_FETCH_LIVE=false

# --- AI (Google Gemini) -------------------------------------------------------
# Keyword intent, the AI SEO Audit and the Gap & Competitor recommendations.
# Without it: intent falls back to word patterns/tool labels, the AI audit is
# unavailable, and the gap report has data sheets only.
GEMINI_API_KEY=
# Model for keyword intent (fast, cheap) and for the audit/gap reports (stronger).
# GEMINI_MODEL=gemini-flash-lite-latest
# GEMINI_AUDIT_MODEL=gemini-flash-latest
# Alternative intent classifier, used only when GEMINI_API_KEY is not set.
# ANTHROPIC_API_KEY=

# --- File storage ------------------------------------------------------------
# Uploaded keyword Excel files and generated reports. Both default to
# repo-relative folders locally (git-ignored); in production BOTH must point
# at the persistent volume, or every file is lost on the next redeploy/restart.
UPLOADS_DIR=uploads
REPORTS_DIR=reports

# --- Server / CORS ------------------------------------------------------------
PORT=3001
# Set to exactly "production" in production -- this also controls whether
# session cookies are issued as secure/sameSite=none (required for the
# frontend and backend being on different domains).
NODE_ENV=development
# Comma-separated list of origins allowed to call this API cross-origin.
CORS_ORIGINS=http://localhost:5173

# --- Frontend (Vercel project settings / frontend/.env, not this file) -------
# VITE_API_BASE_URL=https://your-backend.up.railway.app   # baked in at build time; leave unset locally (Vite proxies /api to the backend instead)
