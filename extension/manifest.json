{
  "manifest_version": 3,
  "name": "SERP Console Agent",
  "version": "0.1.0",
  "description": "Runs SERP Console's Domain Intelligence exports in this Chrome (where the team is signed in to the SEO tools) and sends the files back to the dashboard.",
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["alarms", "storage", "unlimitedStorage", "tabs", "scripting", "notifications", "downloads", "debugger"],
  "host_permissions": [
    "https://seotooladda.com/*",
    "https://*.seotooladda.com/*",
    "https://flikover.com/*",
    "https://ahn.flikover.com/*",
    "https://woorank.com/*",
    "https://*.woorank.com/*",
    "http://localhost:3001/*",
    "https://serp-console-backend-production.up.railway.app/*"
  ],
  "optional_host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["https://seotooladda.com/*", "https://*.seotooladda.com/*", "https://flikover.com/*", "https://ahn.flikover.com/*", "https://woorank.com/*", "https://*.woorank.com/*"],
      "js": ["recorder.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": { "128": "icon.png" },
  "action": { "default_popup": "popup.html", "default_title": "SERP Console Agent", "default_icon": "icon.png" },
  "options_page": "options.html"
}
